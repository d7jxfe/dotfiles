[colors]
; Load colors from wal/Xresources
background = ${xrdb:color0:#1e1e1e}
foreground = ${xrdb:color7:#ffffff}
primary = ${xrdb:color1:#ff6b6b}
secondary = ${xrdb:color2:#51cf66}
alert = ${xrdb:color3:#f03e3e}
background-alt = ${xrdb:color8:#333333}
foreground-alt = ${xrdb:color15:#dddddd}

[bar/main]
width = 100%
height = 22
background = ${colors.background}
foreground = ${colors.foreground}

dpi-x = 96
dpi-y = 96

line-size = 2
line-color = ${colors.primary}
border-size = 0

padding-left = 2
padding-right = 2

font-0 = JetBrainsMono Nerd Font:size=10;2

modules-left = i3
modules-center = xwindow
modules-right = cpu sp1 gpu sp1 date

enable-ipc = true

[module/i3]
type = internal/i3
format = <label-state>
index-sort = true

label-focused = %name%
label-focused-foreground = ${colors.background}
label-focused-background = ${colors.primary}
label-focused-underline = ${colors.primary}
label-focused-padding = 1

label-unfocused = %name%
label-unfocused-foreground = ${colors.foreground-alt}
label-unfocused-padding = 1

label-visible = %name%
label-visible-foreground = ${colors.foreground}
label-visible-padding = 1

label-urgent = %name%
label-urgent-background = ${colors.alert}
label-urgent-foreground = ${colors.foreground}
label-urgent-padding = 1

[module/sp1]
type = custom/text
content = " | "
content-foreground = ${colors.background-alt}

[module/xwindow]
type = internal/xwindow
label = %title:0:60%

[module/cpu]
type = internal/cpu
interval = 2
format = CPU <label>
label = %percentage%%
format-foreground = ${colors.foreground}

[module/gpu]
type = custom/script
exec = ~/.config/polybar/scripts/gpu.sh
interval = 2
format = GPU <label>
label = %output%
format-foreground = ${colors.foreground}

[module/date]
type = internal/date
interval = 1

time = "%a %d %I:%M %P"

label = %time%
label-foreground = ${colors.foreground}
